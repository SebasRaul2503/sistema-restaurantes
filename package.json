{
  "name": "sistema-restaurantes",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión para restaurantes pequeños y medianos en Perú",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:api": "pnpm --filter @restaurante/api start:dev",
    "dev:web": "pnpm --filter @restaurante/web start",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @restaurante/api build",
    "build:web": "pnpm --filter @restaurante/web build",
    "build:shared": "pnpm --filter @restaurante/shared-types build",
    "prisma:generate": "pnpm --filter @restaurante/api prisma:generate",
    "prisma:migrate": "pnpm --filter @restaurante/api prisma:migrate",
    "prisma:seed": "pnpm --filter @restaurante/api prisma:seed",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.33.4"
}
