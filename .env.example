# ==========================================================================
# Configuración de entorno - Sistema de Gestión de Restaurantes
# Copie este archivo a `.env` y ajuste los valores antes de iniciar.
# ==========================================================================

# --- Base de datos PostgreSQL ---
POSTGRES_USER=restaurante
POSTGRES_PASSWORD=restaurante_dev_password
POSTGRES_DB=restaurante
POSTGRES_PORT=5432

# URL de conexión usada por Prisma (apunta al contenedor `postgres`)
DATABASE_URL=postgresql://restaurante:restaurante_dev_password@postgres:5432/restaurante?schema=public

# --- API (NestJS) ---
API_PORT=3000
NODE_ENV=development

# Secretos JWT — CAMBIE ESTOS VALORES EN PRODUCCIÓN
JWT_ACCESS_SECRET=cambie_este_secreto_de_acceso_en_produccion
JWT_REFRESH_SECRET=cambie_este_secreto_de_refresco_en_produccion
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origen permitido para CORS (la app web)
CORS_ORIGIN=http://localhost:4200

# Usuario administrador inicial (creado por el seed)
SEED_ADMIN_EMAIL=admin@restaurante.pe
SEED_ADMIN_PASSWORD=Admin1234
SEED_ADMIN_NAME=Administrador

# --- Web (Angular) ---
WEB_PORT=4200
API_URL=http://localhost:3000
